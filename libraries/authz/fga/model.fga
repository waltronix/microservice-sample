model
  schema 1.1

type user

type system
  relations
    define admin: [user]

type group
  relations
    define admin: [user]
    define member: [user] or admin

type book
  relations
    define owner: [user]
    define writer: [user, group#member] or owner
    define reader: [user, group#member] or writer

type review
  relations
    define owner: [user]
    define writer: [user, group#member] or owner
    define reader: [user, group#member] or writer
