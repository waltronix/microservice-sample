# Database connection strings
USERS_DATABASE_URL=postgres://users:users@localhost:5432/users
BOOKS_DATABASE_URL=postgres://books:books@localhost:5432/books
REVIEWS_DATABASE_URL=postgres://reviews:reviews@localhost:5432/reviews

# Service bind addresses
USERS_BIND_ADDR=0.0.0.0:3001
BOOKS_BIND_ADDR=0.0.0.0:3002
REVIEWS_BIND_ADDR=0.0.0.0:3003

# Authorization backend — set exactly one of the two blocks below.

# OpenFGA (default) — run scripts/init-openfga.sh once after `podman compose up -d`
# to obtain the STORE_ID and MODEL_ID values.
OPENFGA_URL=http://localhost:8080
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

# OPA (build services with --features opa --no-default-features)
# OPA_URL=http://localhost:8181
